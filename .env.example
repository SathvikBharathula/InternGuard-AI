# InternGuard AI - Environment Configuration Template
# Copy this file to .env and provide your actual settings.
# Do NOT commit your actual .env file to version control.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000

# Groq Autonomous Agent Configuration (Phase 4)
# Provide your actual Groq API key in your local environment or .env file:
# GROQ_API_KEY=gsk_your_groq_api_key_here
# Configurable Groq model (defaults to llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile
